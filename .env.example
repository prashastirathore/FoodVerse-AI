# FoodVerse AI – Global Environment Configuration Example

# Google Gemini API Key (Optional - runs in Zero-Config Demo Mode if not provided)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Connection String (Local instance or MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=foodverse_db

# Security & JWT Authentication
JWT_SECRET=foodverse-forest-mint-cream-super-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (comma separated list of frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
